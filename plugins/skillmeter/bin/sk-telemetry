#!/usr/bin/env node
/**
 * Forward project or global collection controls to scripts/telemetry.js.
 * Usage: node bin/sk-telemetry <enable|disable|status> [--global],
 * or node bin/sk-telemetry consent-preview [--json].
 */
const path = require("path");

const PLUGIN_ROOT =
  process.env.PLUGIN_ROOT ||
  process.env.CLAUDE_PLUGIN_ROOT ||
  path.resolve(__dirname, "..");
process.env.PLUGIN_ROOT = PLUGIN_ROOT;
process.env.CLAUDE_PLUGIN_ROOT = PLUGIN_ROOT;

require(path.join(PLUGIN_ROOT, "scripts", "telemetry.js"));
